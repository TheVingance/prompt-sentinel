# ==============================================================================
# PromptSentinel - Environment Variables Example
# ==============================================================================

# Application Settings
PROJECT_NAME="PromptSentinel AI Firewall"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Gateway Security & Upstream Target
SENTINEL_API_KEY=sentinel-default-local-key
TARGET_LLM_BASE_URL=https://api.openai.com/v1
TARGET_LLM_API_KEY=

# PostgreSQL Database (with pgvector)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secure_pass
POSTGRES_DB=sentinel_db

# Redis (Rate Limiting & Semantic Cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Security Heuristics & Vector Search
SIMILARITY_THRESHOLD=0.82
RATE_LIMIT_REQUESTS_PER_MINUTE=60
